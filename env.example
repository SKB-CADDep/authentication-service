# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/auth_db

# LDAP
LDAP_SERVER=ldap://dc03.utz.local
LDAP_PORT=389
LDAP_TIMEOUT_SECONDS=5
LDAP_BASE_DN=DC=utz,DC=local
LDAP_USER_SUFFIX=@utz.local
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# JWT
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
JWT_ISSUER=utz-auth-service
JWT_AUDIENCE=utz-services
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=replace-with-a-strong-redis-password

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# App
APP_NAME=UTZ Auth Service
DEBUG=False

# Database credentials for Docker Compose
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=replace-with-a-strong-database-password
AUTH_DB_NAME=auth_db

# Shared network for services that consume authentication API
SHARED_NETWORK_NAME=utz_shared_services

